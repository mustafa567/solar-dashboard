# Copy this file to .env (in the project root) and fill in your values.

# --- PVS6 gateway ---------------------------------------------------------
# IP address or hostname of the PVS6 on your LAN.
#
# Prefer the mDNS name: this gateway is on Wi-Fi with a DHCP lease, so its IP
# moves, and "pvs.local" follows it. If an IP is set here and it stops
# answering, the app falls back automatically -- mDNS, then the ARP table using
# the gateway's own MAC (learned on first connect) -- and remembers whatever
# worked in data/gateway-location.json.
#
# The permanent fix is a DHCP reservation for the PVS on your router.
PVS_HOST=pvs.local
# Full serial number of the PVS6. The local API password is the last 5 chars,
# which the app derives automatically. Optional: if the gateway reports its own
# serial during discovery that value wins; this is the fallback.
PVS_SN=ZT999999999999A9999

# --- Poller ---------------------------------------------------------------
# Seconds between readings. 30-60 is the sensible range.
POLL_INTERVAL_SECONDS=60
# Backoff bounds used when the gateway is unreachable.
POLL_BACKOFF_MIN_SECONDS=5
POLL_BACKOFF_MAX_SECONDS=300
# How long to wait on a single gateway HTTP request before giving up.
REQUEST_TIMEOUT_SECONDS=30

# --- Meter interpretation -------------------------------------------------
# Only used when /sys/livedata reads back empty and the app falls back to the
# built-in meters. 'net' (default) means the consumption CTs measure net grid
# flow, positive when importing. Use 'load' if they are wired on the load side
# and measure total house consumption instead. If the dashboard's arrows look
# inverted or Home Usage looks like grid import, this is the knob to try.
METER_CONSUMPTION_MODE=net

# --- Net/consumption channel calibration ----------------------------------
# Multiplier applied to the grid (net) power channel before the house load is
# derived. Leave at 1.0 unless the gateway is reporting a physically impossible
# house load -- a negative site_load_p, which the app logs a warning about and
# reports as `implausible` on /api/status.
#
# Background for THIS gateway: its net CT reads 2x high (measured from 28h of
# samples -- see README troubleshooting), so the right value here is 0.5. The
# site_load_en / net_en counters carry the same error; only pv_en is clean.
#
# Changing this only affects new readings. Stop the service and run
# backend/scripts/recalibrate.py to bring stored history into line.
GRID_SCALE=1.0

# --- Storage --------------------------------------------------------------
# SQLite file. Relative paths resolve against the project root.
DB_PATH=data/solar.db
# Samples further apart than this are treated as a gap and contribute no energy
# to the rollups (stops an outage from being integrated as flat power).
MAX_SAMPLE_GAP_SECONDS=300
# IANA timezone used for day/week/month/year boundaries in the history views.
# Leave blank to use this PC's timezone, which is usually what you want.
# TIMEZONE=America/Los_Angeles

# --- Backups --------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_DIR=data/backups
BACKUP_KEEP_DAYS=14

# --- API server -----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Directory of built frontend assets, served by FastAPI at /. Built by
# `npm run build` in frontend/.
STATIC_DIR=frontend/dist
LOG_LEVEL=INFO
